    JEEDOM_DIR="${JEEDOM_DIR}" BACKUP_DIR="${BACKUP_DIR}" PLUGIN_ID="${plugin_id}" php <<'PHP'
<?php
$root = getenv('JEEDOM_DIR');
$backupDir = getenv('BACKUP_DIR');
$target = getenv('PLUGIN_ID');
require_once $root . '/core/php/console.php';
require_once $root . '/core/php/core.inc.php';
$plugins = plugin::listPlugin(true, false, false);
$ids = array();
foreach ($plugins as $plugin) {
    $ids[] = $plugin->getId();
}
if (!is_dir($backupDir)) {
    mkdir($backupDir, 0775, true);
}
$snapshot = $backupDir . '/plugins_active_' . date('Ymd-His') . '.txt';
file_put_contents($snapshot, implode("\n", $ids) . "\n");
echo "Snapshot plugins actifs : " . $snapshot . "\n";
try {
    $plugin = plugin::byId($target);
    if (!$plugin->isActive()) {
        echo "Plugin déjà inactif : " . $target . "\n";
        exit;
    }
    $plugin->setIsEnable(0, true, true);
    echo "Désactivé : " . $target . "\n";
} catch (Throwable $e) {
    echo "Erreur sur " . $target . " : " . $e->getMessage() . "\n";
}
PHP
    pause
}

