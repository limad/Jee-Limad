main_menu() {
    local choice
    while true; do
        choice=$(menu_choose "JEEDOM - Menu d'administration" "Sélectionnez une action" 24 82 12 \
            "1" "Informations système" \
            "2" "Sauvegardes (${BACKUP_DIR})" \
            "3" "Base de données" \
            "4" "Services & Jeedom" \
            "5" "Logs" \
            "6" "Réseau" \
            "7" "Mises à jour" \
            "8" "Nettoyage" \
            "9" "Maintenance avancée / rescue" \
            "10" "Stockage & santé HDD" \
            "0" "Quitter") || { echo -e "\n${G}Au revoir !${N}\n"; exit 0; }

        case "$choice" in
            1) show_system_info ;;
            2) menu_backups ;;
            3) menu_database ;;
            4) menu_services ;;
            5) menu_logs ;;
            6) menu_network ;;
            7) menu_updates ;;
            8) menu_cleanup ;;
            9) menu_maintenance ;;
            10) storage_menu ;;
            0) echo -e "\n${G}Au revoir !${N}\n"; exit 0 ;;
            *) echo -e "${R}Choix invalide.${N}"; sleep 1 ;;
        esac
    done
}

