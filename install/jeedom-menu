<?php
$root = getenv('JEEDOM_DIR');
require_once $root . '/core/php/console.php';
require_once $root . '/core/config/common.config.php';
require_once $root . '/core/class/DB.class.php';
$rows = DB::Prepare("SELECT plugin FROM config WHERE `key`='active' AND `value`='1' ORDER BY plugin", array(), DB::FETCH_TYPE_ALL);
$issue = false;
foreach ($rows as $row) {
    $id = $row['plugin'];
    $classFile = $root . '/plugins/' . $id . '/core/class/' . $id . '.class.php';
    if (!file_exists($classFile)) {
        printf("%-30s CLASS MANQUANTE: %s\n", $id, $classFile);
        $issue = true;
        continue;
    }
    try {
        include_once $classFile;
        if (!class_exists($id, false)) {
            printf("%-30s CLASSE ABSENTE dans le fichier\n", $id);
            $issue = true;
        }
    } catch (Throwable $e) {
        printf("%-30s ERREUR: %s\n", $id, $e->getMessage());
        $issue = true;
    }
}
if (!$issue) {
    echo "Aucun défaut de chargement détecté sur les plugins actifs.\n";
}
PHP
    pause
}

disable_one_plugin() {
