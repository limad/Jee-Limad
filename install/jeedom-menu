restore_plugins_from_snapshot() {
    local num i snapshot
    local -a files menu_items

    section "Réactivation plugins depuis snapshot"
    mapfile -t files < <(ls -t "${BACKUP_DIR}"/plugins_active_*.txt 2>/dev/null)
    [[ ${#files[@]} -eq 0 ]] && { echo -e "${R}Aucun snapshot plugins dans ${BACKUP_DIR}.${N}"; pause; return; }

    for i in "${!files[@]}"; do
        menu_items+=("$((i+1))" "$(basename "${files[$i]}")")
    done
    menu_items+=("0" "Annuler")

    num=$(menu_choose "Snapshots plugins - ${BACKUP_DIR}" "Snapshot à restaurer" 22 82 14 "${menu_items[@]}") || return
    [[ "$num" == "0" || -z "$num" ]] && return
    [[ ! "$num" =~ ^[0-9]+$ || $num -lt 1 || $num -gt ${#files[@]} ]] && { echo -e "${R}Choix invalide.${N}"; pause; return; }

    snapshot="${files[$((num-1))]}"
    confirm "Réactiver les plugins listés dans $(basename "${snapshot}") ?" "Réactivation plugins" || return

    JEEDOM_DIR="${JEEDOM_DIR}" SNAPSHOT="${snapshot}" php <<'PHP'
<?php
$root = getenv('JEEDOM_DIR');
$snapshot = getenv('SNAPSHOT');
require_once $root . '/core/php/console.php';
require_once $root . '/core/php/core.inc.php';
$ids = file($snapshot, FILE_IGNORE_NEW_LINES | FILE_SKIP_EMPTY_LINES);
foreach ($ids as $id) {
    try {
        $plugin = plugin::byId(trim($id));
        $plugin->setIsEnable(1, true, true);
        echo "Réactivé : " . $id . "\n";
    } catch (Throwable $e) {
        echo "Erreur sur " . $id . " : " . $e->getMessage() . "\n";
    }
}
PHP
    pause
}

check_item() {
    local label="$1" command="$2"

    if eval "$command" >/dev/null 2>&1; then
        printf "  ${G}OK ${N} %s\n" "$label"
    else
        printf "  ${R}NOK${N} %s\n" "$label"
    fi
}

menu_preflight() {
    section "Prévol menu Jeedom"

    echo -e "${W}Chemins Jeedom${N}"
    check_item "Répertoire Jeedom: ${JEEDOM_DIR}" "test -d '${JEEDOM_DIR}'"
    check_item "Configuration: ${CONF_FILE}" "test -f '${CONF_FILE}'"
    check_item "Répertoire backup: ${BACKUP_DIR}" "test -d '${BACKUP_DIR}'"
    check_item "Répertoire log: ${LOG_DIR}" "test -d '${LOG_DIR}'"
    check_item "Répertoire install: ${INSTALL_DIR}" "test -d '${INSTALL_DIR}'"
    check_item "health.sh" "test -f '${HEALTH_SCRIPT}'"

    echo
    echo -e "${W}Scripts Jeedom appelés par le menu${N}"
    for script in backup.php restore.php update.php database.php cleaning.php consistency.php; do
        check_item "install/${script}" "test -f '${INSTALL_DIR}/${script}'"
    done

    echo
    echo -e "${W}Outils système${N}"
    for bin in php mysql mysqlcheck mysqldump tar systemctl curl ip ss ping apt-get find awk sed grep; do
        check_item "$bin" "command -v '${bin}'"
    done

    echo
    echo -e "${W}Core Jeedom${N}"
    JEEDOM_DIR="${JEEDOM_DIR}" php <<'PHP'
<?php
$root = getenv('JEEDOM_DIR');
try {
    require_once $root . '/core/php/console.php';
    require_once $root . '/core/php/core.inc.php';
    echo "  OK  Chargement core.inc.php\n";
    echo "  OK  Version Jeedom : " . jeedom::version() . "\n";
    echo "  OK  Chemin backup configuré : " . config::byKey('backup::path') . "\n";
} catch (Throwable $e) {
    echo "  NOK Chargement core Jeedom : " . $e->getMessage() . "\n";
}
PHP

    pause
}

show_rescue_url() {
    local ip_addr

    section "URL mode rescue éditeur cron"
    ip_addr=$(local_ip)
    if [[ -z "$ip_addr" ]]; then
        echo -e "${R}Impossible de déterminer l'IP locale.${N}"
    else
        echo "http://${ip_addr}/index.php?v=d&p=cron&rescue=1"
    fi
    pause
}

