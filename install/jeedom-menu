menu_logs() {
    local choice
    while true; do
        choice=$(menu_choose "Logs Jeedom" "Choix" 19 78 8 \
            "1" "Lister les fichiers de log" \
            "2" "Afficher un log (50 dernières lignes)" \
            "3" "Suivre un log temps réel (Ctrl+C)" \
            "4" "Vider tous les logs (DANGER)" \
            "5" "Log système (lecture seule)" \
            "6" "Logs critiques Jeedom (lecture seule)" \
            "0" "Retour") || return

        case "$choice" in
            1) list_logs ;;
            2) view_log ;;
            3) tail_log ;;
            4) clear_logs ;;
            5) system_log ;;
            6) view_critical_logs ;;
            0) return ;;
        esac
    done
}

list_logs() {
    section "Fichiers de log disponibles"
    if [[ ! -d "${LOG_DIR}" ]]; then
        echo -e "${R}Répertoire log introuvable.${N}"
    else
        printf "  %-40s %s\n" "Fichier" "Taille"
        printf "  %-40s %s\n" "───────────────────────────────────────" "──────"
        while IFS= read -r f; do
            SIZE=$(du -sh "$f" 2>/dev/null | cut -f1)
            printf "  %-40s %s\n" "$(basename "$f")" "${SIZE}"
        done < <(ls -S "${LOG_DIR}"/*.log 2>/dev/null; ls -S "${LOG_DIR}"/* 2>/dev/null | grep -v '\.log$')
    fi
    pause
}

pick_log_file() {
    local num i
    local -a logs menu_items

    mapfile -t logs < <(find "${LOG_DIR}" -maxdepth 1 -type f 2>/dev/null | sort)
    [[ ${#logs[@]} -eq 0 ]] && { echo -e "${R}Aucun log trouvé.${N}"; return 1; }

    for i in "${!logs[@]}"; do
        menu_items+=("$((i+1))" "$(basename "${logs[$i]}")")
    done
    menu_items+=("0" "Annuler")

    num=$(menu_choose "Logs Jeedom" "Choisir un log" 22 78 14 "${menu_items[@]}") || return 1
    [[ "$num" == "0" || -z "$num" ]] && return 1
    [[ ! "$num" =~ ^[0-9]+$ || $num -lt 1 || $num -gt ${#logs[@]} ]] && { echo -e "${R}Choix invalide.${N}"; return 1; }
    PICKED_LOG="${logs[$((num-1))]}"
}

view_log() {
    section "Affichage d'un log"
    pick_log_file || { pause; return; }
    echo
    tail -50 "${PICKED_LOG}"
    pause
}

tail_log() {
    section "Suivi temps réel (Ctrl+C pour quitter)"
    pick_log_file || { pause; return; }
    echo
    tail -f "${PICKED_LOG}"
}

clear_logs() {
    section "Suppression des logs"
    confirm "Supprimer TOUS les logs Jeedom ?" "Suppression des logs" || { echo -e "${Y}Annulé.${N}"; pause; return; }
    find "${LOG_DIR}" -maxdepth 1 -type f -exec truncate -s 0 {} \;
    echo -e "${G}✔ Logs vidés (fichiers conservés, contenu effacé).${N}"
    pause
}

system_log() {
    section "Logs système (50 dernières lignes)"
    journalctl -n 50 --no-pager 2>/dev/null || tail -50 /var/log/syslog 2>/dev/null
    pause
}

view_critical_logs() {
    local log file alt

    section "Logs critiques Jeedom"
    for log in backup update restore http.error error scenario cron cron_execution install; do
        file="${LOG_DIR}/${log}"
        alt="${LOG_DIR}/${log}.log"
        [[ -f "$file" || ! -f "$alt" ]] || file="$alt"

        echo -e "${W}== ${log} ==${N}"
        if [[ ! -f "$file" ]]; then
            echo "absent"
        elif ! grep -q '[^[:space:]]' "$file" 2>/dev/null; then
            echo "(vide)"
        else
            tail -80 "$file"
        fi
        echo
    done
    pause
}

