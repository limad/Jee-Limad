show_network_interfaces() {
    section "Interfaces réseau"
    ip -4 addr show | grep -E "^[0-9]|inet " | awk '
        /^[0-9]/ { iface=$2 }
        /inet /  { print "  " iface "  " $2 }'
    echo
    ip route | grep default | awk '{print "  Passerelle : " $3}'
    echo -e "  DNS : $(cat /etc/resolv.conf | grep nameserver | awk '{print $2}' | tr '\n' ' ')"
    pause
