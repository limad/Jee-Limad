    for i in "${!rows[@]}"; do
        menu_items+=("$((i+1))" "${rows[$i]}")
    done
    menu_items+=("0" "Annuler")

    num=$(menu_choose "Plugins actifs" "Plugin à désactiver" 22 82 14 "${menu_items[@]}") || return
    [[ "$num" == "0" || -z "$num" ]] && return
    [[ ! "$num" =~ ^[0-9]+$ || $num -lt 1 || $num -gt ${#rows[@]} ]] && { echo -e "${R}Choix invalide.${N}"; pause; return; }

    row="${rows[$((num-1))]}"
    plugin_id="${row%%|*}"
    confirm "Désactiver uniquement le plugin ${plugin_id} ? Un snapshot sera créé dans ${BACKUP_DIR}." "Désactivation plugin" || return
    token=$(prompt_input "Confirmation forte" "Tapez ${plugin_id} pour confirmer") || return
