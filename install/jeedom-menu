#!/bin/bash
# ============================================================
#  jeedom-menu.sh — Menu d'administration interactif Jeedom
#  Testé sur Debian 11/12, Jeedom >= 4.4
#  Usage : sudo bash jeedom-menu.sh
# ============================================================

# --- Chemins & constantes -----------------------------------
JEEDOM_DIR="/var/www/html"
BACKUP_DIR="${JEEDOM_DIR}/backup"
LOG_DIR="${JEEDOM_DIR}/log"
CONF_FILE="${JEEDOM_DIR}/core/config/common.config.php"
INSTALL_DIR="${JEEDOM_DIR}/install"
HEALTH_SCRIPT="${JEEDOM_DIR}/health.sh"

TUI_BACKTITLE="Jeedom Administration - ${JEEDOM_DIR}"
TUI_BIN=""

# --- Couleurs -----------------------------------------------
R='\033[0;31m'  G='\033[0;32m'  Y='\033[1;33m'
B='\033[0;34m'  C='\033[0;36m'  W='\033[1;37m'  N='\033[0m'

# --- Vérifications ------------------------------------------
check_root() {
    [[ $EUID -ne 0 ]] && { echo -e "${R}[ERREUR] Ce script doit être lancé en root (sudo).${N}"; exit 1; }
}

check_jeedom() {
    [[ ! -f "${CONF_FILE}" ]] && { echo -e "${R}[ERREUR] Jeedom non détecté dans ${JEEDOM_DIR}${N}"; exit 1; }
}

# --- Lecture config MySQL depuis Jeedom ---------------------
get_mysql_creds() {
    DB_HOST=$(grep "db:host"   "${CONF_FILE}" | sed "s/.*=> *'\(.*\)'.*/\1/")
    DB_PORT=$(grep "db:port"   "${CONF_FILE}" | sed "s/.*=> *'\(.*\)'.*/\1/")
    DB_NAME=$(grep "db:dbname" "${CONF_FILE}" | sed "s/.*=> *'\(.*\)'.*/\1/")
    DB_USER=$(grep "db:username" "${CONF_FILE}" | sed "s/.*=> *'\(.*\)'.*/\1/")
    DB_PASS=$(grep "db:password" "${CONF_FILE}" | sed "s/.*=> *'\(.*\)'.*/\1/")
    DB_PORT=${DB_PORT:-3306}
}

mysql_cmd() {
    get_mysql_creds
    mysql -h"${DB_HOST}" -P"${DB_PORT}" -u"${DB_USER}" -p"${DB_PASS}" "${DB_NAME}" "$@" 2>/dev/null
}

# --- Utilitaires affichage ----------------------------------
init_tui() {
    [[ -t 0 && -t 1 ]] || return 0
    if command -v whiptail >/dev/null 2>&1; then
        TUI_BIN="whiptail"
    elif command -v dialog >/dev/null 2>&1; then
        TUI_BIN="dialog"
    fi
}

tui_available() { [[ -n "${TUI_BIN}" ]]; }

pause() {
    [[ -t 0 ]] || return 0
    echo
    read -rp "$(echo -e "${Y}Appuyez sur [Entrée] pour continuer...${N}")"
}

header() {
    [[ -t 1 ]] && clear 2>/dev/null || true
    echo -e "${B}╔══════════════════════════════════════════════════════╗${N}"
    echo -e "${B}║${W}        🏠  JEEDOM — Menu d'administration           ${B}║${N}"
    echo -e "${B}╚══════════════════════════════════════════════════════╝${N}"
    echo
}

section() { echo -e "\n${C}── $1 ──────────────────────────────────────────${N}\n"; }

menu_choose() {
    local title="$1" prompt="$2" height="${3:-20}" width="${4:-78}" menu_height="${5:-10}"
    shift 5
    local choice status tag desc

    if tui_available; then
        choice=$("${TUI_BIN}" --clear --backtitle "${TUI_BACKTITLE}" --title "$title" \
            --menu "$prompt" "$height" "$width" "$menu_height" "$@" 3>&1 1>&2 2>&3)
        status=$?
        [[ -t 1 ]] && clear 2>/dev/null || true
        [[ $status -eq 0 ]] || return "$status"
        printf '%s\n' "$choice"
        return 0
    fi

    header >&2
    section "$title" >&2
    while (($#)); do
        tag="$1"
        desc="$2"
        shift 2
        printf "  ${W}%s)${N} %s\n" "$tag" "$desc" >&2
    done
    echo >&2
    read -rp "$(echo -e "${Y}${prompt} : ${N}")" choice || return 1
    printf '%s\n' "$choice"
}

confirm() {
    local message="$1" title="${2:-Confirmation}" answer status

    if tui_available; then
        "${TUI_BIN}" --clear --backtitle "${TUI_BACKTITLE}" --title "$title" \
            --yesno "$message" 10 72
        status=$?
        [[ -t 1 ]] && clear 2>/dev/null || true
        return "$status"
    fi

    read -rp "$(echo -e "${Y}${message} (oui/non) : ${N}")" answer
    [[ "${answer,,}" == "oui" || "${answer,,}" == "o" || "${answer,,}" == "yes" || "${answer,,}" == "y" ]]
}

prompt_input() {
    local title="$1" message="$2" default="${3:-}" value status

    if tui_available; then
        value=$("${TUI_BIN}" --clear --backtitle "${TUI_BACKTITLE}" --title "$title" \
            --inputbox "$message" 10 72 "$default" 3>&1 1>&2 2>&3)
        status=$?
        [[ -t 1 ]] && clear 2>/dev/null || true
        [[ $status -eq 0 ]] || return "$status"
        printf '%s\n' "$value"
        return 0
    fi

    read -rp "$(echo -e "${Y}${message} : ${N}")" value || return 1
    printf '%s\n' "$value"
}

local_ip() {
    ip -4 addr show scope global 2>/dev/null | grep -oP '(?<=inet\s)\d+(\.\d+){3}' | head -1
}

service_exists() {
    systemctl list-unit-files "${1}.service" --no-legend 2>/dev/null | grep -q . ||
        systemctl list-units --all "${1}.service" --no-legend 2>/dev/null | grep -q .
}

run_install_php() {
    local script="$1" title="$2"

    section "$title"
    php "${INSTALL_DIR}/${script}" 2>&1
    pause
}

# ============================================================
#  FONCTIONS — INFORMATIONS SYSTÈME
# ============================================================

show_system_info() {
    header
    section "Informations système"

    # IP locale (première interface non-loopback)
    IP_LOCAL=$(ip -4 addr show scope global | grep -oP '(?<=inet\s)\d+(\.\d+){3}' | head -1)
    # IP externe (via opendns ou curl)
    IP_EXT=$(curl -s --max-time 5 https://api.ipify.org 2>/dev/null || echo "non disponible")

    UPTIME=$(uptime -p 2>/dev/null || uptime)
    MEM_TOTAL=$(free -h | awk '/^Mem:/{print $2}')
    MEM_USED=$(free -h  | awk '/^Mem:/{print $3}')
    DISK_USE=$(df -h "${JEEDOM_DIR}" | awk 'NR==2{print $3"/"$2" ("$5")"}')
    LOAD=$(cat /proc/loadavg | awk '{print $1, $2, $3}')
    JEE_VER=$(php -r "define('_DST_JEEDOM', true); include '${JEEDOM_DIR}/core/config/version'; echo trim(file_get_contents('${JEEDOM_DIR}/core/config/version'));" 2>/dev/null \
              || grep -r "version" "${JEEDOM_DIR}/core/config/version" 2>/dev/null | head -1 \
              || echo "inconnue")

    echo -e "  ${W}IP locale   :${N}  ${G}${IP_LOCAL:-inconnu}${N}"
    echo -e "  ${W}IP externe  :${N}  ${G}${IP_EXT}${N}"
    echo
    echo -e "  ${W}Hostname    :${N}  $(hostname)"
    echo -e "  ${W}OS          :${N}  $(cat /etc/os-release | grep PRETTY | cut -d= -f2 | tr -d '"')"
    echo -e "  ${W}Kernel      :${N}  $(uname -r)"
    echo
    echo -e "  ${W}Jeedom ver  :${N}  ${JEE_VER}"
    echo -e "  ${W}PHP ver     :${N}  $(php -r 'echo PHP_VERSION;' 2>/dev/null)"
    echo -e "  ${W}MySQL ver   :${N}  $(mysql --version 2>/dev/null | awk '{print $5}' | tr -d ',')"
    echo
    echo -e "  ${W}Uptime      :${N}  ${UPTIME}"
    echo -e "  ${W}Charge CPU  :${N}  ${LOAD}"
    echo -e "  ${W}RAM         :${N}  ${MEM_USED} / ${MEM_TOTAL}"
    echo -e "  ${W}Disque      :${N}  ${DISK_USE}"

    section "État des services"
    for svc in apache2 nginx mysql mariadb; do
        if service_exists "${svc}"; then
            STATUS=$(systemctl is-active "${svc}" 2>/dev/null || echo "inactive")
            [[ "${STATUS}" == "active" ]] \
                && echo -e "  ${G}●${N} ${svc} : actif" \
                || echo -e "  ${R}●${N} ${svc} : ${STATUS}"
        fi
    done

    pause
}


storage_menu() {
    local choice
    while true; do
        choice=$(menu_choose "Stockage & santé HDD" "Choix" 17 78 5 \
            "1" "Diagnostic stockage/HDD (lecture seule)" \
            "2" "Installer smartmontools SMART (modifie)" \
            "0" "Retour") || return

        case "$choice" in
            1) storage_health ;;
            2) install_smartmontools ;;
            0) return ;;
        esac
    done
}

storage_health() {
    local errors dev
    local -a disks

    section "Stockage & santé HDD"

    echo -e "${W}Occupation disque${N}"
    df -hT / "${JEEDOM_DIR}" "${BACKUP_DIR}" 2>/dev/null | awk 'NR==1 || !seen[$1 "|" $7]++'

    echo
    echo -e "${W}Inodes${N}"
    df -ih / "${JEEDOM_DIR}" "${BACKUP_DIR}" 2>/dev/null | awk 'NR==1 || !seen[$1 "|" $6]++'

    echo
    echo -e "${W}Montage Jeedom${N}"
    findmnt -T "${JEEDOM_DIR}" -no TARGET,SOURCE,FSTYPE,OPTIONS 2>/dev/null || echo "Montage introuvable."

    echo
    echo -e "${W}Vue disques / partitions${N}"
    lsblk -o NAME,TYPE,SIZE,FSTYPE,FSUSE%,MOUNTPOINT,MODEL,ROTA,TRAN 2>/dev/null || echo "lsblk indisponible."

    echo
    echo -e "${W}SMART${N}"
    if ! command -v smartctl >/dev/null 2>&1; then
        echo "smartctl absent : installer smartmontools pour lire la santé SMART si le disque l'expose."
    else
        mapfile -t disks < <(lsblk -dn -o NAME,TYPE 2>/dev/null | awk '$2 == "disk" {print "/dev/" $1}')
        [[ ${#disks[@]} -eq 0 ]] && echo "Aucun disque bloc détecté."
        for dev in "${disks[@]}"; do
            echo "== ${dev} =="
            smartctl -H "${dev}" 2>&1 | grep -Ei 'SMART overall-health|SMART Health Status|PASSED|FAILED|not available|unavailable|does not support' || true
            smartctl -A "${dev}" 2>/dev/null | awk '/Reallocated|Current_Pending|Offline_Uncorrectable|Media_Wearout|Wear_Leveling|Percentage_Used|Power_On_Hours|Temperature|Airflow_Temperature/ {print}' || true
            echo
        done
    fi

    echo
    echo -e "${W}Erreurs disque kernel récentes${N}"
    errors=$((dmesg -T 2>/dev/null || journalctl -k --no-pager -n 300 2>/dev/null || true) | grep -Ei 'i/o error|blk_update_request|ext4-fs error|xfs.*error|btrfs.*error|buffer i/o|nvme.*error|ata[0-9].*error|medium error|uncorrectable' | tail -20)
    if [[ -n "${errors}" ]]; then
        printf '%s
' "${errors}"
    else
        echo "Aucune erreur disque récente trouvée dans le journal kernel lu."
    fi

    echo
    echo -e "${W}Seuils d'action${N}"
    echo "- > 80% disque : surveiller et nettoyer logs/sauvegardes anciennes."
    echo "- > 90% disque : agir avant blocage Jeedom/MySQL."
    echo "- SMART FAILED, secteurs réalloués/pending, erreurs I/O : sauvegarde externe puis remplacement disque."

    pause
}

install_smartmontools() {
    local token

    section "Installation smartmontools"
    if command -v smartctl >/dev/null 2>&1; then
        echo "smartctl est déjà disponible : $(command -v smartctl)"
        smartctl --version 2>/dev/null | head -1 || true
        pause
        return
    fi

    confirm "Installer smartmontools via apt-get ? Cette action modifie le système." "Installation SMART" || return
    token=$(prompt_input "Confirmation forte" "Tapez SMARTTOOLS pour confirmer") || return
    [[ "$token" == "SMARTTOOLS" ]] || { echo -e "${Y}Annulé.${N}"; pause; return; }

    DEBIAN_FRONTEND=noninteractive apt-get update 2>&1
    DEBIAN_FRONTEND=noninteractive apt-get install -y smartmontools 2>&1

    if command -v smartctl >/dev/null 2>&1; then
        echo -e "\n${G}✔ smartmontools installé.${N}"
        smartctl --version 2>/dev/null | head -1 || true
    else
        echo -e "\n${R}smartctl reste introuvable après installation.${N}"
    fi
    pause
}

# ============================================================
#  FONCTIONS — SAUVEGARDES
# ============================================================

menu_backups() {
    local choice
    while true; do
        choice=$(menu_choose "Sauvegardes - ${BACKUP_DIR}" "Choix" 17 76 6 \
            "1" "Lister les sauvegardes (lecture seule)" \
            "2" "Créer une sauvegarde (modifie)" \
            "3" "Restaurer une sauvegarde (DANGER)" \
            "4" "Supprimer une sauvegarde (DANGER)" \
            "5" "Diagnostic sauvegardes (lecture seule)" \
            "0" "Retour") || return

        case "$choice" in
            1) list_backups ;;
            2) create_backup ;;
            3) restore_backup ;;
            4) delete_backup ;;
            5) backup_diagnostics ;;
            0) return ;;
        esac
    done
}

list_backups() {
    local i size
    local -a files dirs

    section "Sauvegardes disponibles (${BACKUP_DIR})"
    if [[ ! -d "${BACKUP_DIR}" ]]; then
        echo -e "${R}Répertoire backup introuvable : ${BACKUP_DIR}${N}"
        pause
        return
    fi

    mapfile -t files < <(find "${BACKUP_DIR}" -maxdepth 1 -type f -name "*.tar.gz" 2>/dev/null | sort -r)
    if [[ ${#files[@]} -eq 0 ]]; then
        echo -e "${Y}Aucune sauvegarde Jeedom restaurable (*.tar.gz) trouvée.${N}"
    else
        printf "  %-5s %-45s %s\n" "N°" "Fichier" "Taille"
        printf "  %-5s %-45s %s\n" "──" "───────────────────────────────────────────" "──────"
        i=1
        for f in "${files[@]}"; do
            size=$(du -sh "$f" | cut -f1)
            printf "  ${W}%-5s${N} %-45s %s\n" "$i)" "$(basename "$f")" "$size"
            ((i++))
        done
    fi

    mapfile -t dirs < <(find "${BACKUP_DIR}" -mindepth 1 -maxdepth 1 -type d 2>/dev/null | sort)
    if [[ ${#dirs[@]} -gt 0 ]]; then
        echo
        echo -e "${Y}Dossiers présents mais non restaurables par ce menu :${N}"
        for f in "${dirs[@]}"; do
            size=$(du -sh "$f" | cut -f1)
            printf "  %-45s %s\n" "$(basename "$f")" "$size"
        done
    fi

    pause
}

backup_diagnostics() {
    local archive_count dir_count backup_log configured_path resolved_path keep_days max_size total_size

    section "Diagnostic sauvegardes"
    configured_path=$(JEEDOM_DIR="${JEEDOM_DIR}" php <<'PHP'
<?php
$root = getenv('JEEDOM_DIR');
require_once $root . '/core/php/console.php';
require_once $root . '/core/php/core.inc.php';
echo config::byKey('backup::path');
PHP
)
    keep_days=$(JEEDOM_DIR="${JEEDOM_DIR}" php <<'PHP'
<?php
$root = getenv('JEEDOM_DIR');
require_once $root . '/core/php/console.php';
require_once $root . '/core/php/core.inc.php';
echo config::byKey('backup::keepDays');
PHP
)
    max_size=$(JEEDOM_DIR="${JEEDOM_DIR}" php <<'PHP'
<?php
$root = getenv('JEEDOM_DIR');
require_once $root . '/core/php/console.php';
require_once $root . '/core/php/core.inc.php';
echo config::byKey('backup::maxSize');
PHP
)
    if [[ "${configured_path}" = /* ]]; then
        resolved_path="${configured_path}"
    else
        resolved_path="${JEEDOM_DIR}/${configured_path}"
    fi

    echo -e "${W}Configuration Jeedom${N}"
    echo "  backup::path     : ${configured_path}"
    echo "  chemin résolu     : ${resolved_path}"
    echo "  chemin du menu    : ${BACKUP_DIR}"
    echo "  conservation      : ${keep_days:-inconnue} jour(s)"
    echo "  taille max dossier: ${max_size:-inconnue} Mo"

    echo
    echo -e "${W}État du dossier${N}"
    if [[ -d "${BACKUP_DIR}" ]]; then
        total_size=$(du -sh "${BACKUP_DIR}" 2>/dev/null | cut -f1)
        archive_count=$(find "${BACKUP_DIR}" -maxdepth 1 -type f -name "*.tar.gz" 2>/dev/null | wc -l)
        dir_count=$(find "${BACKUP_DIR}" -mindepth 1 -maxdepth 1 -type d 2>/dev/null | wc -l)
        echo "  existe            : oui"
        echo "  écriture          : $([[ -w "${BACKUP_DIR}" ]] && echo oui || echo non)"
        echo "  taille            : ${total_size}"
        echo "  archives *.tar.gz : ${archive_count}"
        echo "  dossiers          : ${dir_count}"
    else
        echo -e "  ${R}existe            : non${N}"
    fi

    echo
    echo -e "${W}Outils requis par install/backup.php${N}"
    for bin in php mysqldump tar gzip find; do
        check_item "$bin" "command -v '${bin}'"
    done

    echo
    echo -e "${W}Log backup Jeedom${N}"
    backup_log="${LOG_DIR}/backup"
    if [[ -e "${backup_log}" ]] && grep -q '[^[:space:]]' "${backup_log}"; then
        echo "  fichier : ${backup_log}"
        echo
        tail -80 "${backup_log}"
    elif [[ -e "${backup_log}" ]]; then
        echo "  fichier : ${backup_log} (vide)"
    else
        echo "  aucun log backup trouvé dans ${LOG_DIR}"
    fi

    pause
}

create_backup() {
    local status latest

    section "Création d'une sauvegarde"
    confirm "Créer une sauvegarde Jeedom dans ${BACKUP_DIR} ?" "Sauvegarde" || return
    echo -e "${Y}Lancement de install/backup.php (peut prendre quelques minutes)...${N}"
    echo
    php "${INSTALL_DIR}/backup.php" 2>&1
    status=$?
    echo
    if [[ $status -eq 0 ]]; then
        latest=$(find "${BACKUP_DIR}" -maxdepth 1 -type f -name "*.tar.gz" -printf '%T@ %p\n' 2>/dev/null | sort -nr | awk 'NR==1{print $2}')
        if [[ -n "$latest" ]]; then
            echo -e "${G}✔ Sauvegarde créée : $(basename "${latest}")${N}"
        else
            echo -e "${Y}Commande terminée, mais aucune archive *.tar.gz trouvée dans ${BACKUP_DIR}.${N}"
        fi
    else
        echo -e "${R}✘ Erreur lors de la sauvegarde (code ${status})${N}"
    fi
    pause
}

restore_backup() {
    local num i size chosen status
    local -a files menu_items

    section "Restauration d'une sauvegarde (${BACKUP_DIR})"
    mapfile -t files < <(find "${BACKUP_DIR}" -maxdepth 1 -type f -name "*.tar.gz" 2>/dev/null | sort -r)
    if [[ ${#files[@]} -eq 0 ]]; then
        echo -e "${R}Aucune sauvegarde Jeedom restaurable (*.tar.gz) dans ${BACKUP_DIR}.${N}"
        pause; return
    fi

    for i in "${!files[@]}"; do
        size=$(du -sh "${files[$i]}" | cut -f1)
        menu_items+=("$((i+1))" "$(basename "${files[$i]}") (${size})")
    done
    menu_items+=("0" "Annuler")

    num=$(menu_choose "Restauration - ${BACKUP_DIR}" "Numéro à restaurer" 22 78 14 "${menu_items[@]}") || return
    [[ "$num" == "0" || -z "$num" ]] && return
    [[ ! "$num" =~ ^[0-9]+$ || $num -lt 1 || $num -gt ${#files[@]} ]] && { echo -e "${R}Choix invalide.${N}"; pause; return; }

    chosen="${files[$((num-1))]}"
    echo
    echo -e "${R}⚠  ATTENTION : La restauration va écraser la configuration actuelle !${N}"
    echo -e "   Fichier : ${W}$(basename "${chosen}")${N}"
    echo
    confirm "Restaurer $(basename "${chosen}") ? La configuration actuelle sera écrasée." "Restauration" || { echo -e "${Y}Restauration annulée.${N}"; pause; return; }

    echo
    echo -e "${Y}Restauration via install/restore.php...${N}"
    php "${INSTALL_DIR}/restore.php" "backup=${chosen}" 2>&1
    status=$?
    echo
    [[ $status -eq 0 ]] \
        && echo -e "${G}✔ Restauration terminée. Redémarrez Jeedom si nécessaire.${N}" \
        || echo -e "${R}✘ Erreur lors de la restauration (code ${status})${N}"
    pause
}

delete_backup() {
    local num i chosen
    local -a files menu_items

    section "Suppression d'une sauvegarde (${BACKUP_DIR})"
    mapfile -t files < <(ls -t "${BACKUP_DIR}"/*.tar.gz 2>/dev/null)
    [[ ${#files[@]} -eq 0 ]] && { echo -e "${R}Aucune sauvegarde dans ${BACKUP_DIR}.${N}"; pause; return; }

    for i in "${!files[@]}"; do
        menu_items+=("$((i+1))" "$(basename "${files[$i]}")")
    done
    menu_items+=("0" "Annuler")

    num=$(menu_choose "Suppression - ${BACKUP_DIR}" "Numéro à supprimer" 22 78 14 "${menu_items[@]}") || return
    [[ "$num" == "0" || -z "$num" ]] && return
    [[ ! "$num" =~ ^[0-9]+$ || $num -lt 1 || $num -gt ${#files[@]} ]] && { echo -e "${R}Choix invalide.${N}"; pause; return; }

    chosen="${files[$((num-1))]}"
    confirm "Supprimer $(basename "${chosen}") ?" "Suppression" || return
    rm -f "${chosen}" && echo -e "${G}✔ Fichier supprimé.${N}" || echo -e "${R}✘ Erreur.${N}"
    pause
}

# ============================================================
#  FONCTIONS — BASE DE DONNÉES
# ============================================================

menu_database() {
    local choice
    while true; do
        choice=$(menu_choose "Base de données MySQL/MariaDB" "Choix" 19 78 8 \
            "1" "Vérifier la santé de la DB (ANALYZE)" \
            "2" "Réparer les tables (REPAIR TABLE)" \
            "3" "Optimiser les tables (OPTIMIZE TABLE)" \
            "4" "Taille des tables" \
            "5" "Vider le cache Jeedom (BDD + fichiers)" \
            "6" "Lancer mysqlcheck complet" \
            "0" "Retour") || return

        case "$choice" in
            1) db_analyze ;;
            2) db_repair ;;
            3) db_optimize ;;
            4) db_table_sizes ;;
            5) jeedom_flush_cache ;;
            6) db_mysqlcheck ;;
            0) return ;;
        esac
    done
}

db_analyze() {
    section "ANALYZE TABLE — vérification des index"
    get_mysql_creds
    TABLES=$(mysql_cmd -N -e "SHOW TABLES;")
    echo "$TABLES" | while read -r tbl; do
        RESULT=$(mysql_cmd -N -e "ANALYZE TABLE \`${tbl}\`;" | awk '{print $NF}')
        printf "  %-35s %s\n" "${tbl}" "${RESULT}"
    done
    pause
}

db_repair() {
    section "REPAIR TABLE — réparation des tables MyISAM"
    get_mysql_creds
    TABLES=$(mysql_cmd -N -e "SHOW TABLES;")
    echo -e "${Y}Réparation en cours...${N}\n"
    echo "$TABLES" | while read -r tbl; do
        RESULT=$(mysql_cmd -N -e "REPAIR TABLE \`${tbl}\`;" | awk '{print $NF}')
        printf "  %-35s %s\n" "${tbl}" "${RESULT}"
    done
    echo -e "\n${G}✔ Réparation terminée.${N}"
    pause
}

db_optimize() {
    section "OPTIMIZE TABLE — défragmentation"
    get_mysql_creds
    TABLES=$(mysql_cmd -N -e "SHOW TABLES;")
    echo -e "${Y}Optimisation en cours...${N}\n"
    echo "$TABLES" | while read -r tbl; do
        RESULT=$(mysql_cmd -N -e "OPTIMIZE TABLE \`${tbl}\`;" | awk '{print $NF}')
        printf "  %-35s %s\n" "${tbl}" "${RESULT}"
    done
    echo -e "\n${G}✔ Optimisation terminée.${N}"
    pause
}

db_table_sizes() {
    section "Taille des tables"
    get_mysql_creds
    mysql_cmd -e "
        SELECT
            table_name AS 'Table',
            ROUND((data_length + index_length) / 1024 / 1024, 2) AS 'Taille (Mo)',
            table_rows AS 'Lignes'
        FROM information_schema.tables
        WHERE table_schema = '${DB_NAME}'
