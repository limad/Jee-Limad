test_internet() {
    section "Test connectivité internet"
    for host in 8.8.8.8 1.1.1.1 google.com; do
        if ping -c1 -W2 "${host}" &>/dev/null; then
            echo -e "  ${G}✔${N} ${host} joignable"
        else
            echo -e "  ${R}✘${N} ${host} non joignable"
        fi
    done
    pause
}

test_ports() {
    section "Test des ports web"
    LOCAL_IP=$(ip -4 addr show scope global | grep -oP '(?<=inet\s)\d+(\.\d+){3}' | head -1)
    for port in 80 443 8080; do
        if ss -tlnp 2>/dev/null | grep -q ":${port} "; then
            echo -e "  ${G}✔${N} Port ${port} en écoute"
        else
            echo -e "  ${Y}–${N} Port ${port} non ouvert"
        fi
    done
    pause
}

show_connections() {
    section "Connexions actives (ESTABLISHED)"
    ss -tnp 2>/dev/null | grep ESTAB | head -20
    pause
}

do_ping() {
    local addr

    section "Ping"
    addr=$(prompt_input "Ping" "Adresse à pinger") || return
    [[ -z "${addr}" ]] && return
    ping -c4 "${addr}"
    pause
}

